<footer id="site-footer" class="footer  crt-band"> <!-- footer crt-dark -->
  <span class="noise-seq noise-single" style="animation-delay: 0s;"></span>
  <span class="noise-seq noise-double" style="animation-delay: 1.4s;"></span>
  <div class="scanline" aria-hidden="true"></div>

  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="brand"><a href="/">STUDIØ</a></span>
      <span class="dot">•</span>
      <span class="tag">From Zero to One — where ideas go live</span>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="#services">Services</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
      <a href="#contact" class="cta">Get Started</a>
    </nav>

