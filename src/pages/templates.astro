---
import Base from "../layouts/Base.astro";
import LaptopAutoFit from "../components/LaptopAutoFit.astro";
import Footer from '../components/Footer.astro';

import ssLocal from "../assets/screenShots/restaurantdemo01.png";
import ssAngles from "../assets/screenShots/angles5 1600x1200.png";
import ssMinimal from "../assets/screenShots/solid 1600x1200.png";
import ssNature from "../assets/screenShots/willow.jpg";

const templates = [
  {
    name: "Local",
    tagline: "Modern layout for restaurants, pizzerias, cafés, and takeout businesses.",
    imageDesktop: ssLocal,
    //imageDesktop: "/work/restaurantdemo01.png",
    imageMobile: "",
    //imageMobile: "/assets/mockups/solid-mobile.jpg",
    tags: ["Hero", "Story", "Map", "Menu Highlights"],
    theme: "Cool Blue",
    price: "$450",
    demoUrl: "https://template-story-restaurant.netlify.app/?utm_source=sz-templates-local",
    chooseUrl: "/contact?template=solid",
  },
  {
    name: "Angles",
    tagline: "Bold angled sections with strong contrast",
    imageDesktop: ssAngles,
    imageMobile: "",
    tags: ["Hero", "Spotlights", "Contact + Map"],
    theme: "Warm Neutral",
    price: "$450",
    demoUrl: "https://solid-angles-cards.netlify.app/?utm_source=sz-templates-angles",
    chooseUrl: "/contact?template=angles",
  },
  {
    name: "Minimal",
    tagline: "Balanced, professional layout. Features a clean hero, spotlight blocks for showcasing services, and a contact form.",
    imageDesktop: ssMinimal,
    imageMobile: "",
    tags: ["Hero", "Spotlights", "Contact"],
    theme: "Light Gray",
    price: "$400",
    demoUrl: "https://template-minimal.netlify.app/?utm_source=sz-templates-minimal",
    chooseUrl: "/contact?template=minimal",
  },
  {
    name: "Nature",
    tagline: "Simple typography & generous white space",
    imageDesktop: ssNature,
    tags: ["Hero", "About", "Contact"],
    theme: "Light Gray",
    price: "$450",
    demoUrl: "https://client-willow-wellness.netlify.app/?utm_source=sz-templates-nature",
    chooseUrl: "/contact?template=nature",
  },
];
---

<Base title="Choose a Template | Studio Zero">

<!-- Hero -->
  <section class="wrap section-gap bg-crt-subtle bg-crt-mid section-pad">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="section-header pop">Pick a template. Launch fast.</h1>
      <p class="mt-3 text-zinc-600">
        Choose from simple, modern designs built for your small business or project.
        Every design is fully responsive and customized with your colors, logo, and content.
      </p>
    </div>
  </section>

  <section id="work" class="wrap section-gap bg-crt-subtle bg-crt-light section-pad">
  <div class="std-grid std-grid--smart std-grid--fixed">
    {templates.map((it) => (
      <article class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm hover:shadow-md transition">  
        <LaptopAutoFit src={it.imageDesktop} class="w-full max-w-520px mx-auto scale-125" /> {/* class="w-full max-w-520px mx-auto scale-125" */}
          <h2 class="text-center text-xl font-semibold text-black/90">{it.name}</h2>
          <p class="text-center mt-1 text-sm text-zinc-600">{it.tagline}</p>
          {/* <p class="mt-1 text-sm text-black/60">{it.tagline}</p> */}

          <!-- Feature tags -->
            <ul class="mt-3 flex flex-wrap justify-center gap-2 text-xs text-black/60">
              {it.tags.map((tag) => (
                <li class="rounded-full bg-black/5 px-2 py-1">{tag}</li>
              ))}
            </ul>

            <!-- Theme + price -->
            {/* <p class="mt-4 text-sm font-medium text-black/60">{t.theme}</p> */}
            <p class="text-center mt-4 text-base font-semibold text-black/60">{it.price}</p>

            <!-- CTAs -->
          <div class="card-actions mt-6 flex w-full justify-center gap-3 text-black/60">
              <a
                href={it.demoUrl}
                rel="noopener"
                target="_blank"
                class="btn btn-black"
              >
                Live Demo
              </a>
              <a
                href={it.demoUrl}
                class="btn btn-outline"
              >
                Choose This
              </a>
            </div>

      </article>
    ))}
  </div>
  </section>

  <!-- Small upsell/footer note -->
  <section class="std-container pb-20 text-center text-sm text-black/60">
    <p>
      Need something unique? Custom designs start at $999.
      <a href="/contact" class="underline hover:text-black">Get a quote</a>.
    </p>
  </section>
</Base>

<Footer />

<!-- Notes:
- Uses Studio Zero utility classes: .std-container, .std-card, .std-btn, .std-btn--ghost
- Spacing follows your rhythm: py-24 for top section, pb-28 for grid block.
- Colors are neutral and pull from your existing palette; no hard-coded brand colors.
- Replace image paths with real screenshots stored in /public/assets/mockups/.
- Append `?src=templates` to demo links if you'd like to track origin.
-->
